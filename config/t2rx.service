[Unit]
Description=Lynx DVB-T2 Receiver (TV HAT -> HDMI)
After=multi-user.target sound.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /dev/dvb/adapter0/frontend0 ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/python3 /opt/t2rx/t2rxd.py
Restart=always
RestartSec=3
# ahead of background jobs; the OSD drawing thread lowers its own priority
Nice=-5

[Install]
WantedBy=multi-user.target
